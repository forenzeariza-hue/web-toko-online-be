@baseUrl = http://localhost:5001
@productId = GANTI_DENGAN_ID_PRODUK
@token = GANTI_DENGAN_TOKEN_DARI_LOGIN

# CATATAN: semua endpoint /api/products butuh login.
# Jalankan A1/A4 dulu, lalu salin token ke variabel @token di atas.
# Yang publik hanya: /api/health, /api/auth/register, /api/auth/login.

### A1 - Register user baru (201, publik)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nama": "Budi Test",
  "email": "budi@example.com",
  "password": "secret123"
}

### A2 - Register email duplikat (409, publik)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nama": "Budi Test",
  "email": "budi@example.com",
  "password": "secret123"
}

### A3 - Register input tidak valid (400, publik)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "nama": "X",
  "email": "bukan-email",
  "password": "12"
}

### A4 - Login (200, publik; salin token dari response ke @token)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "budi@example.com",
  "password": "secret123"
}

### A5 - Login password salah (401, publik)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "budi@example.com",
  "password": "salah"
}

### A6 - Profil user login (200)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### A7 - Profil tanpa token (401)
GET {{baseUrl}}/api/auth/me

### A8 - Health check (200, publik)
GET {{baseUrl}}/api/health

### T1 - GET semua produk (butuh token, 200)
GET {{baseUrl}}/api/products
Authorization: Bearer {{token}}

### T1b - GET semua produk tanpa token (401)
GET {{baseUrl}}/api/products

### T2 - GET produk by id valid (butuh token, 200)
GET {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### T2b - GET produk by id tanpa token (401)
GET {{baseUrl}}/api/products/{{productId}}

### T3 - GET id tidak ada (butuh token, 404)
GET {{baseUrl}}/api/products/64b7f9c2f1a2b3c4d5e6f7a8
Authorization: Bearer {{token}}

### T4 - POST produk valid (butuh token, 201)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nama": "Topi Baseball",
  "deskripsi": "Topi baseball katun dengan tali adjustable.",
  "harga": 75000,
  "stok": 20,
  "gambar": "https://picsum.photos/seed/topi/400/300",
  "kategori": "Aksesoris"
}

### T4b - POST produk tanpa token (401)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "nama": "Topi Baseball",
  "deskripsi": "Topi baseball katun dengan tali adjustable.",
  "harga": 75000,
  "stok": 20,
  "kategori": "Aksesoris"
}

### T5 - POST produk tanpa field wajib (butuh token, 400)
POST {{baseUrl}}/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nama": "Produk Tanpa Data Lengkap"
}

### T6 - PUT produk valid (butuh token, 200)
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "harga": 199000,
  "stok": 15
}

### T7 - PUT id tidak ada (butuh token, 404)
PUT {{baseUrl}}/api/products/64b7f9c2f1a2b3c4d5e6f7a8
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "harga": 100000
}

### T8 - DELETE produk (butuh token, 200)
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### T9 - DELETE id tidak ada (butuh token, 404)
DELETE {{baseUrl}}/api/products/64b7f9c2f1a2b3c4d5e6f7a8
Authorization: Bearer {{token}}
