  "main": "src/dev-server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/dev-server.js",
    "dev": "nodemon src/dev-server.js",
    "seed": "node src/seed/seedProducts.js && node src/seed/seedUsers.js",
    "seed:products": "node src/seed/seedProducts.js",
